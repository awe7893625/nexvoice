<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.nexvoice.local-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__RUNTIME__</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/local-runtime.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/local-runtime.err.log</string>
</dict></plist>
